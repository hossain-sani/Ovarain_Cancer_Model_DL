{
  "data_dir": "Dataset",
  "output_dir": "output",
  "seed": 42,
  "train_ratio": 0.7,
  "val_ratio": 0.15,
  "test_ratio": 0.15,
  "img_size": 224,
  "filter_mode": "bilateral",
  "augment": true,
  "rotation": 20,
  "brightness": 0.2,
  "contrast": 0.2,
  "saturation": 0.2,
  "hue": 0.1,
  "fe_arch": "attresnet50",
  "fe_epochs": 1,
  "fe_lr": 0.001,
  "fe_weight_decay": 0.0005,
  "fe_momentum": 0.9,
  "fe_dropout": 0.5,
  "fe_dropout2": 0.25,
  "fe_batch": 32,
  "fe_num_workers": 2,
  "n_features": 2048,
  "n_selected": 500,
  "fs_method": "shap",
  "num_round": 100,
  "cls_lr": 0.001,
  "cls_epochs": 1,
  "cls_batch": 32,
  "cls_hidden": 256,
  "cls_dropout": 0.5,
  "cls_dropout2": 0.3,
  "use_gradcam": false
}